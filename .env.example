# OpenPoke Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenRouter API key for LLM access
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Required: Composio API key and Gmail auth config ID
# Get these from https://composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here

# Optional: Typed decisions with Jev (TypeSafe System One)
# Get a key from https://console.typesafe.ai/ — without it OpenPoke behaves
# exactly as before: every classification is made by the LLM.
# NOTE: with this set, email metadata and bodies, and execution-agent tool
# arguments, are sent to api.typesafe.ai in addition to your LLM provider.
# TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional: route System One requests through a gateway instead of calling
# api.typesafe.ai directly (Vercel AI Gateway, Neon, a corporate proxy). Give it
# an origin with no path: the SDK appends /v1/systemone itself, so a value
# ending in /v1 produces /v1/v1/systemone.
# TYPESAFE_BASE_URL=https://your-gateway.example

# Optional: Jev tuning. The model is pinned on purpose — `jev-latest` moves
# when a release ships, and the thresholds in server/jev/thresholds.py are
# calibrated against one model.
# JEV_MODEL=jev-1.13.0
# JEV_TIMEOUT_SECONDS=3.0
# JEV_RETRY_BUDGET_SECONDS=6.0
# JEV_MAX_RETRIES=1
# Hard wall-clock ceiling per decision, retries included.
# JEV_DEADLINE_SECONDS=6.0
# JEV_GUARDRAIL_DEADLINE_SECONDS=3.0
# JEV_STATE_CHAR_BUDGET=24000
# JEV_SEARCH_MAX_CANDIDATES=20

# Optional: the decision log. Stores each decision's probabilities (never email
# bodies) so thresholds can be swept offline without re-asking the model.
# JEV_DECISION_LOG=1
# JEV_DECISION_LOG_MAX_ENTRIES=2000
# JEV_DECISION_LOG_PATH=server/data/jev_decisions.jsonl

# Optional: turn individual typed decisions off (set to 0)
# JEV_EMAIL_SCREENING=1
# JEV_TOOL_GUARDRAIL=1
# JEV_SEARCH_FILTER=1

# Optional: Server configuration
# OPENPOKE_HOST=0.0.0.0
# OPENPOKE_PORT=8001

# Optional: CORS configuration
# OPENPOKE_CORS_ALLOW_ORIGINS=*

# Optional: Documentation
# OPENPOKE_ENABLE_DOCS=1
# OPENPOKE_DOCS_URL=/docs
