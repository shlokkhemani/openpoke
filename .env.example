# OpenPoke Configuration
# Copy this file to .env and fill in your API keys

# Local model server (llama.cpp llama-server), OpenAI-compatible
# Start llama-server with:
#   llama-server -m D:/Claude_Projects/local_LLM/models/Qwen3.5-9B-Q4_K_M.gguf \
#     --alias Qwen3.5-9B-Q4_K_M --jinja -c 131072 --reasoning-format deepseek --port 8080
# --jinja is required for tool/function calling.
# --reasoning off keeps thinking out of the response; if you leave it on, use
#   --reasoning-format deepseek so reasoning lands in reasoning_content.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=Qwen3.5-9B-Q4_K_M
# Optional: only needed if your endpoint requires a bearer token
# LLM_API_KEY=
# Seconds to wait for one completion; local models are slow
LLM_TIMEOUT=300

# Required: Composio API key and Gmail auth config ID
# Get these from https://composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here

# Optional: Server configuration
# OPENPOKE_HOST=0.0.0.0
# OPENPOKE_PORT=8001

# Optional: CORS configuration
# OPENPOKE_CORS_ALLOW_ORIGINS=*

# Optional: Documentation
# OPENPOKE_ENABLE_DOCS=1
# OPENPOKE_DOCS_URL=/docs
